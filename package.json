{
  "name": "gitleaf-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Gitleaf: documentation as Markdown in git, reviewable, attributable and agent-ready. VS Code extension, CLI and MCP server.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "gitleaf": "gitleaf",
    "check:identity": "bash scripts/check-identity.sh",
    "check:themes": "pnpm --filter gitleaf-themes run generate && git diff --exit-code -- packages/themes/themes",
    "clean": "pnpm -r run clean",
    "check:secrets": "gitleaks git --config .gitleaks.toml --redact --no-banner --exit-code 1 . && bash scripts/test-secret-guard.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gitleaf/cli": "workspace:*",
    "@types/node": "^24.10.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^5.0.3"
  }
}
