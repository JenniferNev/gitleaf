{
  "name": "@gitleaf/adapter-git-vscode",
  "version": "0.0.0",
  "description": "Adapter: git-vscode. Implements ports from @gitleaf/core over the VS Code API.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
