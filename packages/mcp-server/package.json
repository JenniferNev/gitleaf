{
  "name": "@gitleaf/mcp-server",
  "version": "0.0.0",
  "description": "Stdio MCP server exposing Gitleaf use cases to Copilot and Claude.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@gitleaf/adapter-fs-node": "workspace:*",
    "@gitleaf/adapter-git-cli": "workspace:*",
    "@gitleaf/core": "workspace:*",
    "@gitleaf/index": "workspace:*",
    "@gitleaf/schema": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.6"
  },
  "bin": {
    "gitleaf-mcp": "./bin/gitleaf-mcp.js"
  }
}
