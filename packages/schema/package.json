{
  "name": "@gitleaf/schema",
  "version": "0.0.0",
  "description": "JSON Schemas (doc frontmatter, gitleaf.yaml, agile module) and migrations.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "generate": "node --experimental-strip-types scripts/generate-types.ts && prettier --write src/generated",
    "check:generated": "pnpm run generate && git diff --exit-code -- src/generated"
  },
  "dependencies": {
    "@gitleaf/core": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^16.0.0",
    "yaml": "^2.9.1"
  }
}
