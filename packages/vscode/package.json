{
  "name": "gitleaf",
  "displayName": "Gitleaf",
  "description": "Documentation as Markdown in git: reviewable, attributable line by line, and agent-ready. Gitleaf for VS Code.",
  "version": "0.0.0",
  "publisher": "gitleaf",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "documentation",
    "markdown",
    "git",
    "provenance",
    "agents"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:gitleaf.yaml",
    "onView:gitleaf.docs"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "gitleaf.mcp",
        "label": "Gitleaf"
      }
    ],
    "chatSkills": [
      {
        "path": "./skills/docs-review/SKILL.md"
      }
    ],
    "colors": [
      {
        "id": "gitleaf.provenanceHuman",
        "description": "Lines written by a person.",
        "defaults": {
          "dark": "#5EE6A8",
          "light": "#158652",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "gitleaf.provenanceAgent",
        "description": "Lines written by an agent.",
        "defaults": {
          "dark": "#CF3BF7",
          "light": "#C00AF1",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "gitleaf.provenanceMixed",
        "description": "Lines written by a person with agent help, or edited by both.",
        "defaults": {
          "dark": "#4AB3F8",
          "light": "#0879C4",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "gitleaf.provenanceUnknown",
        "description": "Lines whose origin is unknown or uncommitted.",
        "defaults": {
          "dark": "descriptionForeground",
          "light": "descriptionForeground",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "gitleaf.reviewDraft",
        "description": "Draft review or pull request.",
        "defaults": {
          "dark": "descriptionForeground",
          "light": "descriptionForeground",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "gitleaf.reviewOpen",
        "description": "Open review awaiting approval.",
        "defaults": {
          "dark": "#4AB3F8",
          "light": "#0879C4",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "gitleaf.reviewChanges",
        "description": "Review with changes requested.",
        "defaults": {
          "dark": "#FC4CBC",
          "light": "#DE048F",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "gitleaf.reviewApproved",
        "description": "Approved review.",
        "defaults": {
          "dark": "#5EE6A8",
          "light": "#158652",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "gitleaf.reviewMerged",
        "description": "Merged review.",
        "defaults": {
          "dark": "#B05FDC",
          "light": "#962DCF",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "gitleaf.docDraft",
        "description": "Doc in draft.",
        "defaults": {
          "dark": "descriptionForeground",
          "light": "descriptionForeground",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "gitleaf.docPublished",
        "description": "Published doc.",
        "defaults": {
          "dark": "#5EE6A8",
          "light": "#158652",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "gitleaf.docStale",
        "description": "Stale doc or overdue review.",
        "defaults": {
          "dark": "#F7F099",
          "light": "#7F760A",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "gitleaf.docArchived",
        "description": "Archived doc.",
        "defaults": {
          "dark": "disabledForeground",
          "light": "disabledForeground",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "gitleaf.chart1",
        "description": "Chart series 1.",
        "defaults": {
          "dark": "#4AB3F8",
          "light": "#0879C4",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "gitleaf.chart2",
        "description": "Chart series 2.",
        "defaults": {
          "dark": "#5EE6A8",
          "light": "#158652",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "gitleaf.chart3",
        "description": "Chart series 3.",
        "defaults": {
          "dark": "#FC4CBC",
          "light": "#DE048F",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "gitleaf.chart4",
        "description": "Chart series 4.",
        "defaults": {
          "dark": "#CF3BF7",
          "light": "#C00AF1",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "gitleaf.chart5",
        "description": "Chart series 5.",
        "defaults": {
          "dark": "#F7F099",
          "light": "#7F760A",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "gitleaf.chart6",
        "description": "Chart series 6.",
        "defaults": {
          "dark": "#B05FDC",
          "light": "#962DCF",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      }
    ],
    "configuration": {
      "title": "Gitleaf",
      "properties": {
        "gitleaf.appearance": {
          "type": "string",
          "default": "default",
          "markdownDescription": "Appearance pack id (`<publisher>.<extension>/<id>`) or `default`. Packs may set their own default through `configurationDefaults`; a missing pack falls back to `default` silently (see the Gitleaf output channel).",
          "scope": "application"
        },
        "gitleaf.mascot": {
          "type": "string",
          "enum": [
            "subtle",
            "playful",
            "off"
          ],
          "default": "subtle",
          "description": "How much an appearance pack's mascot shows up. Hidden under a screen reader.",
          "scope": "application"
        }
      }
    },
    "commands": [
      {
        "command": "gitleaf.initializeWorkspace",
        "title": "Initialize Workspace",
        "category": "Gitleaf",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "gitleaf.refreshDocs",
        "title": "Refresh",
        "category": "Gitleaf",
        "icon": "$(refresh)"
      },
      {
        "command": "gitleaf.validateWorkspace",
        "title": "Validate Docs",
        "category": "Gitleaf"
      },
      {
        "command": "gitleaf.openPreview",
        "title": "Open Preview",
        "category": "Gitleaf",
        "icon": "$(open-preview)"
      },
      {
        "command": "gitleaf.revealInExplorer",
        "title": "Reveal in Explorer View",
        "category": "Gitleaf"
      },
      {
        "command": "gitleaf.selectAppearance",
        "title": "Select Appearance",
        "category": "Gitleaf"
      },
      {
        "command": "gitleaf.showTokenPreview",
        "title": "Show Token Preview",
        "category": "Gitleaf"
      },
      {
        "command": "gitleaf.findAppearancePacks",
        "title": "Find Appearance Packs",
        "category": "Gitleaf"
      },
      {
        "command": "gitleaf.installAppearancePackFromVsix",
        "title": "Install Appearance Pack from VSIX...",
        "category": "Gitleaf"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitleaf",
          "title": "Gitleaf",
          "icon": "media/icons/gitleaf.svg"
        }
      ]
    },
    "views": {
      "gitleaf": [
        {
          "id": "gitleaf.docs",
          "name": "Docs",
          "icon": "media/icons/gitleaf.svg",
          "contextualTitle": "Gitleaf docs"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gitleaf.docs",
        "contents": "No gitleaf.yaml found in this workspace.\n[Initialize Workspace](command:gitleaf.initializeWorkspace)\nGitleaf keeps documentation as Markdown in git, validated and attributable line by line.",
        "when": "workspaceFolderCount > 0"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitleaf.refreshDocs",
          "when": "view == gitleaf.docs",
          "group": "navigation"
        },
        {
          "command": "gitleaf.initializeWorkspace",
          "when": "view == gitleaf.docs && isWorkspaceTrusted"
        }
      ],
      "view/item/context": [
        {
          "command": "gitleaf.openPreview",
          "when": "view == gitleaf.docs && viewItem == doc",
          "group": "inline"
        },
        {
          "command": "gitleaf.revealInExplorer",
          "when": "view == gitleaf.docs && viewItem == doc"
        }
      ],
      "commandPalette": [
        {
          "command": "gitleaf.openPreview",
          "when": "editorLangId == markdown"
        },
        {
          "command": "gitleaf.revealInExplorer",
          "when": "false"
        }
      ]
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode Gitleaf is read-only."
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:production": "node scripts/build.mjs --production",
    "package": "pnpm run build:production && npx --yes @vscode/vsce@4 package --no-dependencies -o gitleaf.vsix",
    "clean": "rm -rf dist skills *.vsix *.tsbuildinfo"
  },
  "dependencies": {
    "@gitleaf/adapter-fs-node": "workspace:*",
    "@gitleaf/adapter-git-cli": "workspace:*",
    "@gitleaf/core": "workspace:*",
    "@gitleaf/format": "workspace:*",
    "@gitleaf/index": "workspace:*",
    "@gitleaf/mcp-server": "workspace:*",
    "@gitleaf/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.104.0",
    "esbuild": "^0.28.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JenniferNev/gitleaf"
  },
  "extensionDependencies": []
}
