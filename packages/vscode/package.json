{
  "name": "gitleaf",
  "displayName": "Gitleaf",
  "description": "Documentation as Markdown in git: reviewable, attributable line by line, and agent-ready. Gitleaf for VS Code.",
  "version": "0.0.0",
  "publisher": "gitleaf",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "documentation",
    "markdown",
    "git",
    "provenance",
    "agents"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "gitleaf.mcp",
        "label": "Gitleaf"
      }
    ],
    "chatSkills": [
      {
        "path": "./skills/docs-review/SKILL.md"
      }
    ]
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode Gitleaf is read-only."
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:production": "node scripts/build.mjs --production",
    "package": "pnpm run build:production && npx --yes @vscode/vsce@4 package --no-dependencies -o gitleaf.vsix",
    "clean": "rm -rf dist skills *.vsix *.tsbuildinfo"
  },
  "dependencies": {
    "@gitleaf/core": "workspace:*",
    "@gitleaf/mcp-server": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.104.0",
    "esbuild": "^0.28.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JenniferNev/gitleaf"
  },
  "extensionDependencies": []
}
