        "description": "A neutral test pack: rounder cards and a mascot slot",
        "tokens": "./appearance/acme.tokens.css",
        "mascot": {
          "dir": "./assets",
          "map": "./appearance/mascot.map.json"
        },
        "copy": {
          "en": "./appearance/copy.en.json"
        },
        "logo": "./assets/logo.svg"
      }
    ],
    "configurationDefaults": {
      "gitleaf.appearance": "acme.acme-appearance/acme"
    }
  }
}
