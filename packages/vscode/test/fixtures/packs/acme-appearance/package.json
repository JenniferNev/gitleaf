{
  "name": "acme-appearance",
  "displayName": "Acme appearance (test fixture)",
  "publisher": "acme",
  "version": "0.0.1",
  "license": "MIT",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "gitleaf-appearance"
  ],
  "contributes": {
    "gitleaf.appearances": [
      {
